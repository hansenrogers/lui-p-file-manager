<Window x:Class="LuiP.FileManager.App.ActivityLogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Activity Log - Lui-P File Manager"
        Width="1200"
        Height="700"
        MinWidth="900"
        MinHeight="550"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="12">
        <Border DockPanel.Dock="Top" Background="#FFF6F6F6" BorderBrush="#FFD8D8D8" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Recent operations and undo availability" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Refresh" MinWidth="100" Padding="12,8" Margin="0,0,8,0" Click="RefreshButton_OnClick" />
                    <Button x:Name="RetryButton" Content="Retry Selected" MinWidth="140" Padding="12,8" Margin="0,0,8,0" Click="RetryButton_OnClick" />
                    <Button x:Name="UndoButton" Content="Undo Selected" MinWidth="150" Padding="12,8" Click="UndoButton_OnClick" />
                </StackPanel>

                <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="SearchTextBox" Height="34" FontSize="14" Padding="8" ToolTip="Search by operation ID, source, destination, or error" TextChanged="SearchTextBox_OnTextChanged" />

                    <ComboBox x:Name="StatusFilterComboBox" Grid.Column="1" Height="34" FontSize="14" Margin="8,0,0,0" SelectionChanged="StatusFilterComboBox_OnSelectionChanged">
                        <ComboBoxItem Content="All Statuses" IsSelected="True" />
                        <ComboBoxItem Content="Completed" />
                        <ComboBoxItem Content="Failed" />
                        <ComboBoxItem Content="Canceled" />
                        <ComboBoxItem Content="PartialFailed" />
                        <ComboBoxItem Content="Running" />
                        <ComboBoxItem Content="Planned" />
                    </ComboBox>

                    <ComboBox x:Name="TransferFilterComboBox" Grid.Column="2" Height="34" FontSize="14" Margin="8,0,0,0" SelectionChanged="TransferFilterComboBox_OnSelectionChanged">
                        <ComboBoxItem Content="All Transfers" IsSelected="True" />
                        <ComboBoxItem Content="Folder" />
                        <ComboBoxItem Content="File" />
                    </ComboBox>

                    <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="8,0,0,0">
                        <Button Content="Open Diagnostics" MinWidth="130" Padding="12,8" Margin="0,0,8,0" Click="OpenDiagnosticsButton_OnClick" />
                        <Button Content="Export CSV" MinWidth="110" Padding="12,8" Margin="0,0,8,0" Click="ExportCsvButton_OnClick" />
                        <Button Content="Export Report" MinWidth="120" Padding="12,8" Click="ExportReportButton_OnClick" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="2*" />
                <RowDefinition Height="10" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <DataGrid x:Name="OperationsDataGrid"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      FontSize="14"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      RowHeaderWidth="0"
                      SelectionMode="Single"
                      SelectionChanged="OperationsDataGrid_OnSelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="When (UTC)" Binding="{Binding StartedUtc}" Width="160" />
                    <DataGridTextColumn Header="Operation ID" Binding="{Binding OperationId}" Width="240" />
                    <DataGridTextColumn Header="Type" Binding="{Binding OperationType}" Width="100" />
                    <DataGridTemplateColumn Header="Transfer" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="10" Padding="8,3" HorizontalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#FFE5E7EB" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding TransferModeLabel}" Value="Folder">
                                                    <Setter Property="Background" Value="#FFFDE68A" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding TransferModeLabel}" Value="File">
                                                    <Setter Property="Background" Value="#FFBFDBFE" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding TransferModeLabel}" FontWeight="SemiBold" />
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="110" />
                    <DataGridTextColumn Header="Items" Binding="{Binding ItemCount}" Width="80" />
                    <DataGridTextColumn Header="Source" Binding="{Binding SourcePath}" Width="*" />
                    <DataGridTextColumn Header="Destination" Binding="{Binding DestinationPath}" Width="*" />
                    <DataGridCheckBoxColumn Header="Undo" Binding="{Binding UndoAvailable}" Width="70" />
                    <DataGridTextColumn Header="Undo Until (UTC)" Binding="{Binding UndoExpiryUtc}" Width="170" />
                    <DataGridTextColumn Header="Error" Binding="{Binding ErrorMessage}" Width="220" />
                </DataGrid.Columns>
            </DataGrid>

            <GridSplitter Grid.Row="1" Height="10" HorizontalAlignment="Stretch" Background="#FFD8D8D8" />

            <GroupBox Grid.Row="2" Header="Selected Operation Items" Padding="8">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button x:Name="OpenItemSourceButton" Content="Open Source" MinWidth="110" Height="32" Margin="0,0,8,0" Click="OpenItemSourceButton_OnClick" />
                        <Button x:Name="OpenItemDestinationButton" Content="Open Destination" MinWidth="130" Height="32" Margin="0,0,8,0" Click="OpenItemDestinationButton_OnClick" />
                        <Button x:Name="OpenItemRecoveryButton" Content="Open Recovery" MinWidth="120" Height="32" Margin="0,0,8,0" Click="OpenItemRecoveryButton_OnClick" />
                        <Button x:Name="CopySelectedItemPathButton" Content="Copy Selected Path" MinWidth="140" Height="32" Click="CopySelectedItemPathButton_OnClick" />
                    </StackPanel>

                    <DataGrid x:Name="OperationItemsDataGrid"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              FontSize="13"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              RowHeaderWidth="0"
                              SelectionMode="Single"
                              SelectionChanged="OperationItemsDataGrid_OnSelectionChanged"
                              MouseDoubleClick="OperationItemsDataGrid_OnMouseDoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Kind" Binding="{Binding Kind}" Width="150" />
                            <DataGridTextColumn Header="Source Path" Binding="{Binding SourcePath}" Width="2*" />
                            <DataGridTextColumn Header="Destination Path" Binding="{Binding DestinationPath}" Width="2*" />
                            <DataGridTextColumn Header="Recovery Path" Binding="{Binding RecoveryPath}" Width="2*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </GroupBox>
        </Grid>
    </DockPanel>
</Window>
