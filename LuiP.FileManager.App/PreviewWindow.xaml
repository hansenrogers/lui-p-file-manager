<Window x:Class="LuiP.FileManager.App.PreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Preview - Lui-P File Manager"
        Width="980"
        Height="700"
        MinWidth="760"
        MinHeight="560"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="12">
        <Border DockPanel.Dock="Top" BorderBrush="#FFD8D8D8" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,10" Background="#FFF7F7F7">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="HeaderTextBlock" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Open Default" MinWidth="120" Padding="12,8" Margin="0,0,8,0" Click="OpenDefaultButton_OnClick" />
                    <Button Content="Show in Folder" MinWidth="120" Padding="12,8" Click="ShowInFolderButton_OnClick" />
                </StackPanel>
            </Grid>
        </Border>

        <TabControl x:Name="PreviewTabControl">
            <TabItem Header="Preview">
                <Grid Margin="6">
                    <Image x:Name="ImagePreview" Stretch="Uniform" Visibility="Collapsed" />
                    <TextBox x:Name="TextPreview" Visibility="Collapsed" FontFamily="Consolas" FontSize="13" IsReadOnly="True" TextWrapping="NoWrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
                    <MediaElement x:Name="MediaPreview" Visibility="Collapsed" LoadedBehavior="Manual" UnloadedBehavior="Stop" />
                    <TextBlock x:Name="UnavailableText" Visibility="Collapsed" FontSize="14" TextWrapping="Wrap" />
                </Grid>
            </TabItem>
            <TabItem Header="Properties">
                <ScrollViewer Margin="8" VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="PropertiesText" FontSize="14" TextWrapping="Wrap" />
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
