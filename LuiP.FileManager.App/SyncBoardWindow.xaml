<Window x:Class="LuiP.FileManager.App.SyncBoardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sync Board"
        WindowState="Maximized"
        Background="#FF0F1722"
        Foreground="#FFE6EFFA"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock Text="ONE-WAY SYNC BOARD" FontSize="28" FontWeight="Bold" DockPanel.Dock="Left" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                <Button Content="⚙" Width="38" Height="34" Margin="0,0,8,0" ToolTip="Gear settings" Click="SetupButton_OnClick" />
                <Button Content="Close" Width="120" Height="38" HorizontalAlignment="Right" Click="CloseButton_OnClick" />
            </StackPanel>
        </DockPanel>

        <TextBlock x:Name="LastSyncTextBlock" Grid.Row="1" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,6" Text="Last sync: never" />

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,6">
            <Button x:Name="ManualSyncButton" Content="Manual Sync Now" Height="36" Width="170" Margin="0,0,10,0" Click="ManualSyncButton_OnClick" />
            <Button Content="Refresh Board" Height="36" Width="140" Click="RefreshBoardButton_OnClick" />
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Vertical" Margin="0,0,0,10">
            <TextBlock x:Name="SourceLocationWarningTextBlock" FontSize="14" FontWeight="SemiBold" Foreground="#FFFFC36B" Text="Source location: not set" />
            <TextBlock x:Name="JobLocationWarningTextBlock" FontSize="14" FontWeight="SemiBold" Foreground="#FFFFC36B" Text="Job location: not set" />
        </StackPanel>

        <Border Grid.Row="4" BorderThickness="1" BorderBrush="#FF526784" CornerRadius="8" Padding="10" Background="#FF182333">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0,0,0,8">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" DockPanel.Dock="Left">
                        <Button Content="Add Person" Width="120" Height="34" Margin="0,0,8,0" Click="AddPersonButton_OnClick" />
                        <Button Content="Add Job" Width="110" Height="34" Margin="0,0,8,0" Click="AddJobButton_OnClick" />
                        <Button Content="Remove Job" Width="120" Height="34" Margin="0,0,8,0" Click="RemoveJobButton_OnClick" />
                        <Button Content="Remove Person" Width="130" Height="34" Click="RemovePersonButton_OnClick" />
                    </StackPanel>
                </DockPanel>

                <DataGrid x:Name="RowsDataGrid"
                          Grid.Row="1"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          HeadersVisibility="Column"
                          RowHeight="34"
                          FontSize="18"
                          AlternationCount="2"
                          Background="#FF121C2A"
                          BorderBrush="#FF5A7292"
                          GridLinesVisibility="All"
                          HorizontalGridLinesBrush="#FF3B4D67"
                          VerticalGridLinesBrush="#FF3B4D67"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          Margin="0,0,0,0"
                          CellEditEnding="RowsDataGrid_OnCellEditEnding"
                          CurrentCellChanged="RowsDataGrid_OnCurrentCellChanged"
                          Sorting="RowsDataGrid_OnSorting">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#FF2A3F5A" />
                            <Setter Property="Foreground" Value="#FFF2F7FF" />
                            <Setter Property="BorderBrush" Value="#FF5A7292" />
                            <Setter Property="BorderThickness" Value="0,0,1,1" />
                            <Setter Property="Padding" Value="6,4" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Background" Value="#FF2E4D73" />
                            <Setter Property="Foreground" Value="#FFF3F8FF" />
                            <Setter Property="BorderBrush" Value="#FF445B78" />
                            <Setter Property="BorderThickness" Value="0,0,0,1" />
                            <Style.Triggers>
                                <Trigger Property="AlternationIndex" Value="1">
                                    <Setter Property="Background" Value="#FF18273C" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#FF3E6999" />
                                    <Setter Property="Foreground" Value="#FFFFFFFF" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                </DataGrid>
            </Grid>
        </Border>

        <TextBlock x:Name="StatusTextBlock" Grid.Row="5" Margin="0,10,0,0" FontSize="14" Text="Ready." />
    </Grid>
</Window>
