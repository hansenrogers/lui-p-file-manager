<Window x:Class="LuiP.FileManager.App.InputPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rename"
        Width="520"
        Height="210"
        MinWidth="460"
        MinHeight="180"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="PromptTextBlock" FontSize="14" TextWrapping="Wrap" Margin="0,0,0,8" />
        <TextBox x:Name="ValueTextBox" Grid.Row="1" Height="34" FontSize="14" Padding="8" />

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Cancel" MinWidth="110" Height="38" Margin="0,0,8,0" Click="CancelButton_OnClick" />
            <Button Content="OK" MinWidth="110" Height="38" IsDefault="True" Click="OkButton_OnClick" />
        </StackPanel>
    </Grid>
</Window>
