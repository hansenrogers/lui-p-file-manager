<Window x:Class="LuiP.FileManager.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings - Lui-P File Manager"
        Width="760"
        Height="520"
        MinWidth="680"
        MinHeight="460"
        Background="#FF161C26"
        Foreground="#FFDCE7F9"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#FF293446" />
            <Setter Property="Foreground" Value="#FFDFE9FA" />
            <Setter Property="BorderBrush" Value="#FF4E6484" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#FF1E2735" />
            <Setter Property="Foreground" Value="#FFDCE7F9" />
            <Setter Property="BorderBrush" Value="#FF4E6484" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#FFDCE7F9" />
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFDCE7F9" />
        </Style>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="Settings" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,10" />
        <TextBlock Grid.Row="1" Text="Configure sources, destinations, and index/status tools." FontSize="15" Margin="0,0,0,16" />

        <UniformGrid Grid.Row="2" Rows="3" Columns="1" Margin="0,0,0,10">
            <Button Content="Edit Source Locations" Height="54" Margin="0,0,0,10" FontSize="16" Click="EditSourcesButton_OnClick" />
            <Button Content="Edit Destination Locations" Height="54" Margin="0,0,0,10" FontSize="16" Click="EditDestinationsButton_OnClick" />
            <Button Content="Index Status" Height="54" FontSize="16" Click="IndexStatusButton_OnClick" />
        </UniformGrid>

        <Border Grid.Row="3" BorderBrush="#FF3F506A" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,10" Background="#FF1F2836">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="Windows Explorer Integration" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <TextBlock x:Name="ShellStatusTextBlock" FontSize="13" Text="Status: Unknown" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Install" MinWidth="100" Height="36" Margin="0,0,8,0" Click="InstallShellButton_OnClick" />
                    <Button Content="Reinstall" MinWidth="100" Height="36" Margin="0,0,8,0" Click="ReinstallShellButton_OnClick" />
                    <Button Content="Uninstall" MinWidth="100" Height="36" Click="UninstallShellButton_OnClick" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="4" BorderBrush="#FF3F506A" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,10" Background="#FF1F2836">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="Copy Verification Defaults" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <CheckBox x:Name="ChecksumDefaultCheckBox" Content="Enable large-file SHA-256 verification by default" Margin="0,0,0,8" />
                    <CheckBox x:Name="ConfirmMoveCheckBox" Content="Ask for confirmation before Move to Destination" Margin="0,0,0,8" />
                    <CheckBox x:Name="SyncBoardAutoSyncCheckBox" Content="Enable Sync Board auto-sync when project files change" Margin="0,0,0,8" />
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Threshold (MB):" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBox x:Name="ChecksumThresholdTextBox" Width="100" Height="28" VerticalContentAlignment="Center" />
                    </StackPanel>
                </StackPanel>

                <Button Grid.Column="1" Content="Save" MinWidth="100" Height="36" Margin="12,0,0,0" VerticalAlignment="Bottom" Click="SaveChecksumSettingsButton_OnClick" />
            </Grid>
        </Border>

        <Grid Grid.Row="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button Content="Run Local Install..." Width="180" Height="44" Margin="0,0,8,0" Click="RunLocalInstallButton_OnClick" />
                <Button Content="Run Local Uninstall..." Width="190" Height="44" Click="RunLocalUninstallButton_OnClick" />
            </StackPanel>
            <Button Grid.Column="1" Content="Close" Width="130" Height="44" HorizontalAlignment="Right" Click="CloseButton_OnClick" />
        </Grid>
    </Grid>
</Window>
