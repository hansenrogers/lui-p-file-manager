<Window x:Class="LuiP.FileManager.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LuiP.FileManager.App"
        mc:Ignorable="d"
        Title="Lui-P File Manager"
        Background="#FFF3F6FB"
        FontFamily="Segoe UI"
        MinWidth="1100"
        MinHeight="700"
        Width="1500"
        Height="900"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="MainWindow_OnPreviewKeyDown">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBgBrush" Color="#FFFFFFFF" />
        <SolidColorBrush x:Key="PanelBorderBrush" Color="#FFD9E2F0" />
        <SolidColorBrush x:Key="PrimaryBrush" Color="#FF0F62FE" />

        <Style TargetType="Button">
            <Setter Property="Background" Value="#FFFFFFFF" />
            <Setter Property="BorderBrush" Value="#FFC7D6EC" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#FF1D2A44" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="2" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FFF1F6FF" />
                    <Setter Property="BorderBrush" Value="#FF95B8F2" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#FFE4EEFF" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.6" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="BorderBrush" Value="#FFC7D6EC" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="#FFFFFFFF" />
            <Setter Property="MinHeight" Value="36" />
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="BorderBrush" Value="#FFC7D6EC" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="#FFFFFFFF" />
            <Setter Property="MinHeight" Value="32" />
        </Style>

        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="BorderBrush" Value="#FFD3DEEE" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="#FFFFFFFF" />
        </Style>

        <Style x:Key="LocationListItemStyle" TargetType="ListViewItem">
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#FFE2EAF6" />
            <Setter Property="Background" Value="#FFFFFFFF" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border x:Name="ItemBorder"
                                CornerRadius="6"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter Margin="2" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#FFF2F7FF" />
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#FF9EB9E8" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#FFDCEAFF" />
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#FF2F6FCC" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#FFFFFFFF" BorderBrush="#FFD8D8D8" BorderThickness="0,0,0,1" Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Lui-P File Manager" FontSize="26" FontWeight="SemiBold" Foreground="#FF143056" Margin="0,0,16,0" />
                    <Menu Margin="0,0,8,0" VerticalAlignment="Center" Background="Transparent">
                        <MenuItem Header="File" FontSize="16" FontWeight="SemiBold">
                            <MenuItem Header="Activity Log" Click="ActivityLogButton_OnClick" />
                            <MenuItem Header="Settings" Click="SettingsButton_OnClick" />
                        </MenuItem>
                        <MenuItem Header="Help" FontSize="16" FontWeight="SemiBold">
                            <MenuItem Header="Help" Click="HelpButton_OnClick" />
                            <MenuItem Header="About" Click="AboutButton_OnClick" />
                        </MenuItem>
                    </Menu>
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Refresh" Padding="14,8" Margin="0,0,8,0" MinWidth="100" Click="RefreshButton_OnClick" AutomationProperties.Name="Refresh file lists" />
                    <Button Content="Preview Selected" Padding="14,8" Margin="0,0,8,0" MinWidth="145" Click="PreviewSelectedButton_OnClick" AutomationProperties.Name="Preview selected item" />
                    <Button Content="Compare Selected" Padding="14,8" Margin="0,0,8,0" MinWidth="150" Click="CompareSelectedButton_OnClick" AutomationProperties.Name="Compare two selected files" />
                    <Button Content="Copy -> Destination" Padding="14,8" Margin="0,0,8,0" MinWidth="165" Click="CopyToDestinationButton_OnClick" AutomationProperties.Name="Copy selected source items to destination" />
                    <Button Content="Create Folder" Padding="14,8" Margin="0,0,8,0" MinWidth="130" Click="CreateFolderButton_OnClick" />
                    <Button Content="Delete Selected" Padding="14,8" Margin="0,0,8,0" MinWidth="140" Click="DeleteSelectedButton_OnClick" />
                    <Button x:Name="ResetLayoutButton" Content="Reset Layout" Padding="14,8" Margin="0,0,8,0" MinWidth="120" Click="ResetLayoutButton_OnClick" />
                    <Button Margin="0,0,0,0"
                            Padding="10,6"
                            MinHeight="30"
                            Click="RebuildIndexButton_OnClick"
                            ToolTip="Click to open full index details">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse x:Name="HeaderIndexingDot" Width="9" Height="9" Fill="#FF2A7A2A" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock x:Name="HeaderIndexingTextBlock"
                                       Text="Indexing"
                                       VerticalAlignment="Center"
                                       Foreground="#FF234066"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Margin="0,0,8,0" />
                            <TextBlock x:Name="HeaderLastIndexedTextBlock"
                                       Text="Last indexed: not yet"
                                       VerticalAlignment="Center"
                                       Foreground="#FF48607E"
                                       FontSize="12" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Border DockPanel.Dock="Bottom" BorderBrush="#FFD8D8D8" BorderThickness="0,1,0,0" Padding="10" Background="#FFFAFAFA">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="Status" FontSize="14" FontWeight="SemiBold" Margin="0,0,12,0" VerticalAlignment="Center" />

                <TextBlock Grid.Column="1"
                           x:Name="StatusTextBlock"
                           Text="Drop files, folders, or programs here"
                           VerticalAlignment="Center"
                           Foreground="#FF525252"
                           FontSize="14" />
            </Grid>
        </Border>

        <Border DockPanel.Dock="Bottom" BorderBrush="#FFE2E2E2" BorderThickness="0,1,0,0" Padding="8" Background="#FFFFFFFF">
            <ListBox x:Name="ShortcutListBox"
                     Height="112"
                     FontSize="14"
                     HorizontalContentAlignment="Stretch"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                     ScrollViewer.VerticalScrollBarVisibility="Disabled"
                     SelectionMode="Single"
                     AllowDrop="True"
                     DragOver="ShortcutListBox_OnDragOver"
                     Drop="ShortcutListBox_OnDrop"
                     PreviewMouseRightButtonDown="ShortcutListBox_OnPreviewMouseRightButtonDown"
                     PreviewMouseRightButtonUp="ShortcutListBox_OnPreviewMouseRightButtonUp"
                     MouseDoubleClick="ShortcutListBox_OnMouseDoubleClick">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Width" Value="92" />
                        <Setter Property="Height" Value="94" />
                        <Setter Property="Margin" Value="4" />
                        <Setter Property="Padding" Value="4" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="VerticalContentAlignment" Value="Stretch" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="6" CornerRadius="8" BorderBrush="#FFD7E2F2" BorderThickness="1" Background="#FFFFFFFF">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Image Source="{Binding Icon}" Width="48" Height="48" Margin="0,0,0,6" Stretch="Uniform" />
                                <TextBlock Text="{Binding Label}" Width="80" TextAlignment="Center" TextWrapping="Wrap" MaxHeight="34" TextTrimming="CharacterEllipsis" FontSize="12" FontWeight="SemiBold" Foreground="#FF203352" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <Grid Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SourceLocationsColumn" Width="2*" MinWidth="220" />
                <ColumnDefinition x:Name="SourceLocationSplitterColumn" Width="5" />
                <ColumnDefinition Width="3*" MinWidth="260" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="3*" MinWidth="260" />
                <ColumnDefinition x:Name="DestinationLocationSplitterColumn" Width="5" />
                <ColumnDefinition x:Name="DestinationLocationsColumn" Width="2*" MinWidth="220" />
            </Grid.ColumnDefinitions>

            <GroupBox x:Name="SourceLocationsGroupBox" Header="Source Locations" Padding="8" Grid.Column="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Configured source roots" FontSize="13" Foreground="#FF4E607A" Margin="2,0,0,0" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="+" MinWidth="34" Height="28" Margin="0,0,6,0" FontSize="16" Click="SourceAddLocationButton_OnClick" ToolTip="Add source location" />
                            <Button Content="-" MinWidth="34" Height="28" FontSize="16" Click="SourceRemoveLocationButton_OnClick" ToolTip="Remove selected source location" />
                        </StackPanel>
                    </Grid>
                    <ListView x:Name="SourceLocationListView" Grid.Row="1" FontSize="15" SelectionChanged="SourceLocationListView_OnSelectionChanged" AutomationProperties.Name="Source locations list" KeyboardNavigation.TabNavigation="Continue" ItemContainerStyle="{StaticResource LocationListItemStyle}">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DisplayName}" ToolTip="{Binding FullPath}" TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock x:Name="SelectedSourceRootTextBlock" Grid.Row="2" Margin="2,8,2,0" FontSize="12" Foreground="#FF2A4E87" Text="Source root: none" TextTrimming="CharacterEllipsis" />
                </Grid>
            </GroupBox>

            <Grid Grid.Column="1" Margin="0">
                <GridSplitter x:Name="SourceLocationsGridSplitter" Width="5" HorizontalAlignment="Stretch" Background="#FFDDDDDD" />
                <Button x:Name="SourceLocationsCollapseButton"
                        Width="16"
                        Height="24"
                        Padding="0"
                        FontSize="11"
                    FontWeight="Bold"
                    Foreground="#FFFFFFFF"
                    Background="#FF2F6FCC"
                    BorderBrush="#FF1F4F99"
                    BorderThickness="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        Margin="0,12,0,0"
                        Click="ToggleSourceLocationsColumnButton_OnClick"
                        ToolTip="Collapse source locations" />
            </Grid>

            <GroupBox Header="Source Items" Padding="8" Grid.Column="2">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="TransferSelectedTextBlock"
                               Text="Moving: None"
                               Margin="2,0,2,8"
                               FontSize="12"
                               Foreground="#FF2A4E87"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Row="1" Text="Search source files and folders" FontSize="12" Foreground="#FF5C5C5C" Margin="2,0,0,4" />
                    <TextBox x:Name="SourceSearchTextBox" Grid.Row="2" Height="36" FontSize="16" Padding="8,4,8,4" VerticalContentAlignment="Center" Margin="0,0,0,8" ToolTip="Search files and folders" TextChanged="SourceSearchTextBox_OnTextChanged" AutomationProperties.Name="Search source files and folders" />
                    <ComboBox x:Name="SourceDateFilterComboBox" Grid.Row="3" Height="30" FontSize="14" Margin="0,0,0,8" SelectionChanged="SourceDateFilterComboBox_OnSelectionChanged" AutomationProperties.Name="Source date filter">
                        <ComboBoxItem Content="All Dates" IsSelected="True" />
                        <ComboBoxItem Content="Today" />
                        <ComboBoxItem Content="Last 7 Days" />
                        <ComboBoxItem Content="Last 30 Days" />
                        <ComboBoxItem Content="This Year" />
                    </ComboBox>
                    <Grid Grid.Row="4" Margin="0,0,0,8">
                        <TextBlock x:Name="SourceCurrentPathTextBlock" VerticalAlignment="Center" Foreground="#FF4A5E80" TextTrimming="CharacterEllipsis" />
                    </Grid>
                    <ListView x:Name="SourceItemListView" Grid.Row="5" FontSize="14" SelectionMode="Extended" SelectionChanged="SourceItemListView_OnSelectionChanged" MouseDoubleClick="SourceItemListView_OnMouseDoubleClick" PreviewMouseMove="SourceItemListView_OnPreviewMouseMove" PreviewMouseRightButtonUp="SourceItemListView_OnPreviewMouseRightButtonUp" GridViewColumnHeader.Click="SourceItemColumnHeader_OnClick" AutomationProperties.Name="Source items list" KeyboardNavigation.TabNavigation="Continue">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="T" Width="34">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <Image Source="{Binding TypeIcon}" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn x:Name="SourceNameColumn" Header="Name" Width="260" DisplayMemberBinding="{Binding Name}" />
                                <GridViewColumn x:Name="SourceModifiedColumn" Header="Modified" Width="170" DisplayMemberBinding="{Binding ModifiedDisplay}" />
                            </GridView>
                        </ListView.View>
                        <ListView.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Open" Click="SourceContextOpen_OnClick" />
                                <MenuItem Header="Preview" Click="SourceContextPreview_OnClick" />
                                <Separator />
                                <MenuItem Header="Properties" Click="SourceContextProperties_OnClick" />
                            </ContextMenu>
                        </ListView.ContextMenu>
                    </ListView>
                </Grid>
            </GroupBox>

            <GridSplitter Grid.Column="3" Width="5" HorizontalAlignment="Stretch" Background="#FFDDDDDD" />

            <GroupBox Header="Destination Items" Padding="8" Grid.Column="4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="TransferDestinationTextBlock"
                               Text="Going To: No destination selected"
                               Margin="2,0,2,8"
                               FontSize="12"
                               Foreground="#FF2A4E87"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Row="1" Text="Search destination files and folders" FontSize="12" Foreground="#FF5C5C5C" Margin="2,0,0,4" />
                    <TextBox x:Name="DestinationSearchTextBox" Grid.Row="2" Height="36" FontSize="16" Padding="8,4,8,4" VerticalContentAlignment="Center" Margin="0,0,0,8" ToolTip="Search destination folder" TextChanged="DestinationSearchTextBox_OnTextChanged" AutomationProperties.Name="Search destination files and folders" />
                    <ComboBox x:Name="DestinationDateFilterComboBox" Grid.Row="3" Height="30" FontSize="14" Margin="0,0,0,8" SelectionChanged="DestinationDateFilterComboBox_OnSelectionChanged" AutomationProperties.Name="Destination date filter">
                        <ComboBoxItem Content="All Dates" IsSelected="True" />
                        <ComboBoxItem Content="Today" />
                        <ComboBoxItem Content="Last 7 Days" />
                        <ComboBoxItem Content="Last 30 Days" />
                        <ComboBoxItem Content="This Year" />
                    </ComboBox>
                    <Grid Grid.Row="4" Margin="0,0,0,8">
                        <TextBlock x:Name="DestinationCurrentPathTextBlock" VerticalAlignment="Center" Foreground="#FF4A5E80" TextTrimming="CharacterEllipsis" />
                    </Grid>
                    <ListView x:Name="DestinationItemListView" Grid.Row="5" FontSize="14" SelectionMode="Extended" SelectionChanged="DestinationItemListView_OnSelectionChanged" MouseDoubleClick="DestinationItemListView_OnMouseDoubleClick" AllowDrop="True" Drop="DestinationItemListView_OnDrop" DragOver="DestinationItemListView_OnDragOver" PreviewMouseRightButtonUp="DestinationItemListView_OnPreviewMouseRightButtonUp" GridViewColumnHeader.Click="DestinationItemColumnHeader_OnClick" AutomationProperties.Name="Destination items list" KeyboardNavigation.TabNavigation="Continue">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="T" Width="34">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <Image Source="{Binding TypeIcon}" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn x:Name="DestinationNameColumn" Header="Name" Width="260" DisplayMemberBinding="{Binding Name}" />
                                <GridViewColumn x:Name="DestinationModifiedColumn" Header="Modified" Width="170" DisplayMemberBinding="{Binding ModifiedDisplay}" />
                            </GridView>
                        </ListView.View>
                        <ListView.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Open" Click="DestinationContextOpen_OnClick" />
                                <MenuItem Header="Preview" Click="DestinationContextPreview_OnClick" />
                                <Separator />
                                <MenuItem Header="Properties" Click="DestinationContextProperties_OnClick" />
                            </ContextMenu>
                        </ListView.ContextMenu>
                    </ListView>
                </Grid>
            </GroupBox>

            <Grid Grid.Column="5" Margin="0">
                <GridSplitter x:Name="DestinationLocationsGridSplitter" Width="5" HorizontalAlignment="Stretch" Background="#FFDDDDDD" />
                <Button x:Name="DestinationLocationsCollapseButton"
                        Width="16"
                        Height="24"
                        Padding="0"
                        FontSize="11"
                    FontWeight="Bold"
                    Foreground="#FFFFFFFF"
                    Background="#FF2F6FCC"
                    BorderBrush="#FF1F4F99"
                    BorderThickness="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        Margin="0,12,0,0"
                        Click="ToggleDestinationLocationsColumnButton_OnClick"
                        ToolTip="Collapse destination locations" />
            </Grid>

            <GroupBox x:Name="DestinationLocationsGroupBox" Header="Destination Locations" Padding="8" Grid.Column="6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Configured destination roots" FontSize="13" Foreground="#FF4E607A" Margin="2,0,0,0" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="+" MinWidth="34" Height="28" Margin="0,0,6,0" FontSize="16" Click="DestinationAddLocationButton_OnClick" ToolTip="Add destination location" />
                            <Button Content="-" MinWidth="34" Height="28" FontSize="16" Click="DestinationRemoveLocationButton_OnClick" ToolTip="Remove selected destination location" />
                        </StackPanel>
                    </Grid>
                    <ListView x:Name="DestinationLocationListView" Grid.Row="1" FontSize="15" SelectionChanged="DestinationLocationListView_OnSelectionChanged" AutomationProperties.Name="Destination locations list" KeyboardNavigation.TabNavigation="Continue" ItemContainerStyle="{StaticResource LocationListItemStyle}">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DisplayName}" ToolTip="{Binding FullPath}" TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock x:Name="SelectedDestinationRootTextBlock" Grid.Row="2" Margin="2,8,2,0" FontSize="12" Foreground="#FF2A4E87" Text="Destination root: none" TextTrimming="CharacterEllipsis" />
                </Grid>
            </GroupBox>
        </Grid>
    </DockPanel>
</Window>
