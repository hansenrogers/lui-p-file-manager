<Window x:Class="LuiP.FileManager.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LuiP.FileManager.App"
        mc:Ignorable="d"
        Title="Lui-P File Manager"
        Icon="pack://application:,,,/Assets/LuiPFileManager.ico"
        Background="#FF121A26"
        FontFamily="Segoe UI"
        MinWidth="1100"
        MinHeight="700"
        Width="1500"
        Height="900"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="MainWindow_OnPreviewKeyDown">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBgBrush" Color="#FF1C2839" />
        <SolidColorBrush x:Key="PanelBorderBrush" Color="#FF7895BD" />
        <SolidColorBrush x:Key="PrimaryBrush" Color="#FFA9CBFF" />

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFF2F7FF" />
        </Style>

        <Style TargetType="Menu">
            <Setter Property="Foreground" Value="#FFF5F9FF" />
            <Setter Property="Background" Value="#FF162131" />
        </Style>

        <Style TargetType="MenuItem">
            <Setter Property="Foreground" Value="#FFF5F9FF" />
            <Setter Property="Background" Value="#FF162131" />
        </Style>

        <Style TargetType="ListView">
            <Setter Property="Background" Value="#FF172333" />
            <Setter Property="Foreground" Value="#FFF2F7FF" />
            <Setter Property="BorderBrush" Value="#FF7895BD" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style TargetType="ListBox">
            <Setter Property="Background" Value="#FF172333" />
            <Setter Property="Foreground" Value="#FFF2F7FF" />
            <Setter Property="BorderBrush" Value="#FF7895BD" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="#FF2B3D56" />
            <Setter Property="BorderBrush" Value="#FF88A9D3" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#FFF5F9FF" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="2" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF385174" />
                    <Setter Property="BorderBrush" Value="#FFA3C2EA" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#FF22334A" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.6" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CopyActionButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#FF2D5A38" />
            <Setter Property="BorderBrush" Value="#FF4D8A5B" />
            <Setter Property="Foreground" Value="#FFE8F7EC" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF336842" />
                    <Setter Property="BorderBrush" Value="#FF5AA86B" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#FF264D31" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="MoveActionButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#FF6A2A2A" />
            <Setter Property="BorderBrush" Value="#FF9D4B4B" />
            <Setter Property="Foreground" Value="#FFFCEBEB" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF7A3131" />
                    <Setter Property="BorderBrush" Value="#FFB25F5F" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#FF592323" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="BorderBrush" Value="#FF8AAAD2" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="#FF1A2A3E" />
            <Setter Property="Foreground" Value="#FFF3F8FF" />
            <Setter Property="MinHeight" Value="36" />
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="BorderBrush" Value="#FF8AAAD2" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="#FF20334B" />
            <Setter Property="Foreground" Value="#FFF5F9FF" />
            <Setter Property="MinHeight" Value="32" />
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#FF20334B" />
            <Setter Property="Foreground" Value="#FFF5F9FF" />
            <Setter Property="Padding" Value="6,2" />
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="#FF2E4C6F" />
                    <Setter Property="Foreground" Value="#FFFFFFFF" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#FF3D6593" />
                    <Setter Property="Foreground" Value="#FFFFFFFF" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DateFilterComboBoxStyle" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Background" Value="#FFF1F6FD" />
            <Setter Property="Foreground" Value="#FF11273F" />
            <Setter Property="BorderBrush" Value="#FF93B3DA" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="6,2" />
        </Style>

        <Style x:Key="DateFilterComboBoxItemStyle" TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
            <Setter Property="Background" Value="#FFF1F6FD" />
            <Setter Property="Foreground" Value="#FF11273F" />
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="#FFD8E7F8" />
                    <Setter Property="Foreground" Value="#FF0D2136" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#FFC1D8F2" />
                    <Setter Property="Foreground" Value="#FF0A1A2C" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="GridViewColumnHeader">
            <Setter Property="Background" Value="#FF4B6F99" />
            <Setter Property="Foreground" Value="#FFFFFFFF" />
            <Setter Property="BorderBrush" Value="#FFA9C4E6" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="BorderBrush" Value="#FF7895BD" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="#FF1C2839" />
            <Setter Property="Foreground" Value="#FFF2F7FF" />
        </Style>

        <Style x:Key="FileListItemStyle" TargetType="ListViewItem">
            <Setter Property="Foreground" Value="#FFF0F6FF" />
            <Setter Property="Background" Value="#FF1A2A3E" />
            <Setter Property="BorderBrush" Value="#00000000" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="2" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF2D4869" />
                    <Setter Property="Foreground" Value="#FFF4F8FF" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#FF5A8AC2" />
                    <Setter Property="Foreground" Value="#FFFFFFFF" />
                    <Setter Property="BorderBrush" Value="#FFE6F1FF" />
                    <Setter Property="BorderThickness" Value="1" />
                </Trigger>
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="IsSelected" Value="True" />
                        <Condition Property="Selector.IsSelectionActive" Value="False" />
                    </MultiTrigger.Conditions>
                    <Setter Property="Background" Value="#FF5A8AC2" />
                    <Setter Property="Foreground" Value="#FFFFFFFF" />
                    <Setter Property="BorderBrush" Value="#FFE6F1FF" />
                    <Setter Property="BorderThickness" Value="1" />
                </MultiTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="LocationListItemStyle" TargetType="ListViewItem">
            <Setter Property="Foreground" Value="#FFF0F6FF" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#FF7895BD" />
            <Setter Property="Background" Value="#FF1E2D42" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border x:Name="ItemBorder"
                                CornerRadius="6"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter Margin="2" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#FF2E4C6F" />
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#FFA8C4E8" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#FF5A8AC2" />
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#FFD9E9FF" />
                                <Setter Property="Foreground" Value="#FFFFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#FF2A3649" BorderBrush="#FF5A6F90" BorderThickness="0,0,0,1" Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Lui-P File Manager" FontSize="26" FontWeight="SemiBold" Foreground="#FFF1F6FF" Margin="0,0,16,0" />
                    <Menu Margin="0,0,8,0" VerticalAlignment="Center" Background="Transparent">
                        <MenuItem Header="File" FontSize="16" FontWeight="SemiBold">
                            <MenuItem Header="Refresh" Click="RefreshButton_OnClick" />
                            <MenuItem Header="Reset Layout" Click="ResetLayoutButton_OnClick" />
                            <Separator />
                            <MenuItem Header="Activity Log" Click="ActivityLogButton_OnClick" />
                            <MenuItem Header="Settings" Click="SettingsButton_OnClick" />
                            <Separator />
                            <MenuItem Header="Exit Program" Click="ExitProgramMenuItem_OnClick" />
                        </MenuItem>
                        <MenuItem Header="Help" FontSize="16" FontWeight="SemiBold">
                            <MenuItem Header="Help" Click="HelpButton_OnClick" />
                            <MenuItem Header="About" Click="AboutButton_OnClick" />
                        </MenuItem>
                    </Menu>
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Sync Board" Padding="14,8" Margin="0,0,8,0" MinWidth="120" Click="SyncBoardButton_OnClick" AutomationProperties.Name="Open sync board" />
                    <Button Content="Preview Selected" Padding="14,8" Margin="0,0,8,0" MinWidth="145" Click="PreviewSelectedButton_OnClick" AutomationProperties.Name="Preview selected item" />
                    <Button Content="Compare Selected" Padding="14,8" Margin="0,0,8,0" MinWidth="150" Click="CompareSelectedButton_OnClick" AutomationProperties.Name="Compare two selected files" />
                    <Button Content="Copy -&gt; Destination" Style="{StaticResource CopyActionButtonStyle}" Padding="14,8" Margin="0,0,8,0" MinWidth="165" Click="CopyToDestinationButton_OnClick" AutomationProperties.Name="Copy selected source items to destination" />
                    <Button Content="Move -&gt; Destination" Style="{StaticResource MoveActionButtonStyle}" Padding="14,8" Margin="0,0,8,0" MinWidth="165" Click="MoveToDestinationButton_OnClick" AutomationProperties.Name="Move selected source items to destination" />
                    <Button Content="+ Folder" Padding="14,8" Margin="0,0,8,0" MinWidth="110" Click="CreateFolderButton_OnClick" />
                    <Button Content="- Folder" Padding="14,8" Margin="0,0,8,0" MinWidth="110" Click="DeleteSelectedButton_OnClick" />
                    <Button Margin="0,0,0,0"
                            Padding="10,6"
                            MinHeight="30"
                            Click="RebuildIndexButton_OnClick"
                            ToolTip="Click to open full index details">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse x:Name="HeaderIndexingDot" Width="9" Height="9" Fill="#FF4DAE6C" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock x:Name="HeaderIndexingTextBlock"
                                       Text="Indexing"
                                       VerticalAlignment="Center"
                                       Foreground="#FFE6EEFA"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Margin="0,0,8,0" />
                            <TextBlock x:Name="HeaderLastIndexedTextBlock"
                                       Text="Last indexed: not yet"
                                       VerticalAlignment="Center"
                                       Foreground="#FFD4DEED"
                                       FontSize="12" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Border DockPanel.Dock="Bottom" BorderBrush="#FF5A6F90" BorderThickness="0,1,0,0" Padding="10" Background="#FF273447">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="Status" FontSize="14" FontWeight="SemiBold" Margin="0,0,12,0" VerticalAlignment="Center" />

                <TextBlock Grid.Column="1"
                           x:Name="StatusTextBlock"
                           Text="Drop files, folders, or programs here"
                           VerticalAlignment="Center"
                           Foreground="#FFD7E3F7"
                           FontSize="14" />
            </Grid>
        </Border>

        <Border DockPanel.Dock="Bottom" BorderBrush="#FF5A6F90" BorderThickness="0,1,0,0" Padding="8" Background="#FF2A3649">
            <ListBox x:Name="ShortcutListBox"
                     Height="128"
                     FontSize="14"
                     HorizontalContentAlignment="Stretch"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                     ScrollViewer.VerticalScrollBarVisibility="Disabled"
                     SelectionMode="Single"
                     AllowDrop="True"
                     DragOver="ShortcutListBox_OnDragOver"
                     Drop="ShortcutListBox_OnDrop"
                     PreviewMouseRightButtonDown="ShortcutListBox_OnPreviewMouseRightButtonDown"
                     PreviewMouseRightButtonUp="ShortcutListBox_OnPreviewMouseRightButtonUp"
                     MouseDoubleClick="ShortcutListBox_OnMouseDoubleClick">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Width" Value="112" />
                        <Setter Property="Height" Value="112" />
                        <Setter Property="Margin" Value="4" />
                        <Setter Property="Padding" Value="4" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="VerticalContentAlignment" Value="Stretch" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="6" CornerRadius="8" BorderBrush="#FF5A6F90" BorderThickness="1" Background="#FF2A3649">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Image Source="{Binding Icon}" Width="48" Height="48" Margin="0,0,0,6" Stretch="Uniform" />
                                <TextBlock Text="{Binding Label}"
                                           Width="100"
                                           Height="28"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap"
                                           TextTrimming="CharacterEllipsis"
                                           LineStackingStrategy="BlockLineHeight"
                                           LineHeight="14"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="#FFE8EFFA" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <Grid Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SourceLocationsColumn" Width="2*" MinWidth="220" />
                <ColumnDefinition x:Name="SourceLocationSplitterColumn" Width="5" />
                <ColumnDefinition Width="3*" MinWidth="260" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="3*" MinWidth="260" />
                <ColumnDefinition x:Name="DestinationLocationSplitterColumn" Width="5" />
                <ColumnDefinition x:Name="DestinationLocationsColumn" Width="2*" MinWidth="220" />
            </Grid.ColumnDefinitions>

            <GroupBox x:Name="SourceLocationsGroupBox" Header="Source Locations" Padding="8" Grid.Column="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="2*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Configured source roots" FontSize="13" Foreground="#FFC6D3E8" Margin="2,0,0,0" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="+" MinWidth="34" Height="28" Margin="0,0,6,0" FontSize="16" Click="SourceAddLocationButton_OnClick" ToolTip="Add source location" />
                            <Button Content="-" MinWidth="34" Height="28" FontSize="16" Click="SourceRemoveLocationButton_OnClick" ToolTip="Remove selected source location" />
                        </StackPanel>
                    </Grid>
                    <ListView x:Name="SourceLocationListView" Grid.Row="1" FontSize="15" SelectionChanged="SourceLocationListView_OnSelectionChanged" AutomationProperties.Name="Source locations list" KeyboardNavigation.TabNavigation="Continue" ItemContainerStyle="{StaticResource LocationListItemStyle}">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DisplayName}" ToolTip="{Binding FullPath}" TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <CheckBox x:Name="SourceRecentsProjectModeCheckBox"
                              Grid.Row="2"
                              Margin="2,8,2,0"
                              Content="Recent source quick access by project number"
                              Checked="SourceRecentsProjectModeCheckBox_OnChanged"
                              Unchecked="SourceRecentsProjectModeCheckBox_OnChanged"
                              ToolTip="Off: recent full folders (default). On: unique recent project numbers." />

                    <TextBlock Grid.Row="3" Margin="2,8,2,4" FontSize="12" Foreground="#FFC6D3E8" Text="Recent source quick access" />

                    <ListView x:Name="RecentSourceListView"
                              Grid.Row="4"
                              Height="140"
                              FontSize="13"
                              SelectionMode="Single"
                              MouseDoubleClick="RecentSourceListView_OnMouseDoubleClick"
                              PreviewKeyDown="RecentSourceListView_OnPreviewKeyDown"
                              AutomationProperties.Name="Recent source quick access"
                              ItemContainerStyle="{StaticResource LocationListItemStyle}">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding DisplayName}" ToolTip="{Binding FullPath}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding SecondaryText}" ToolTip="{Binding FullPath}" TextTrimming="CharacterEllipsis" FontSize="11" Foreground="#FFAEC4E6" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <TextBlock x:Name="SelectedSourceRootTextBlock" Grid.Row="5" Margin="2,8,2,0" FontSize="12" Foreground="#FFAEC4E6" Text="Source root: none" TextTrimming="CharacterEllipsis" />
                </Grid>
            </GroupBox>

            <Grid Grid.Column="1" Margin="0">
                <GridSplitter x:Name="SourceLocationsGridSplitter" Width="5" HorizontalAlignment="Stretch" Background="#FF5A6F90" />
                <Button x:Name="SourceLocationsCollapseButton"
                        Width="16"
                        Height="24"
                        Padding="0"
                        FontSize="11"
                    FontWeight="Bold"
                    Foreground="#FFFFFFFF"
                    Background="#FF30445E"
                    BorderBrush="#FF496386"
                    BorderThickness="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        Margin="0,12,0,0"
                        Click="ToggleSourceLocationsColumnButton_OnClick"
                        ToolTip="Collapse source locations" />
            </Grid>

            <GroupBox Header="Source Items" Padding="8" Grid.Column="2">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="TransferSelectedTextBlock"
                               Text="Moving: None"
                               Margin="2,0,2,8"
                               FontSize="12"
                               Foreground="#FFF1F7FF"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Row="1" Text="Search source files and folders" FontSize="12" Foreground="#FFE9F2FF" Margin="2,0,0,4" />
                    <TextBox x:Name="SourceSearchTextBox" Grid.Row="2" Height="36" FontSize="16" Padding="8,4,8,4" VerticalContentAlignment="Center" Margin="0,0,0,8" ToolTip="Search files and folders" TextChanged="SourceSearchTextBox_OnTextChanged" AutomationProperties.Name="Search source files and folders" />
                    <ComboBox x:Name="SourceDateFilterComboBox" Grid.Row="3" Height="30" FontSize="14" Margin="0,0,0,8" SelectionChanged="SourceDateFilterComboBox_OnSelectionChanged" AutomationProperties.Name="Source date filter" Style="{StaticResource DateFilterComboBoxStyle}">
                        <ComboBoxItem Content="All Dates" IsSelected="True" Style="{StaticResource DateFilterComboBoxItemStyle}" />
                        <ComboBoxItem Content="Today" Style="{StaticResource DateFilterComboBoxItemStyle}" />
                        <ComboBoxItem Content="Last 7 Days" Style="{StaticResource DateFilterComboBoxItemStyle}" />
                        <ComboBoxItem Content="Last 30 Days" Style="{StaticResource DateFilterComboBoxItemStyle}" />
                        <ComboBoxItem Content="This Year" Style="{StaticResource DateFilterComboBoxItemStyle}" />
                    </ComboBox>
                    <Grid Grid.Row="4" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="SourceBackButton" Grid.Column="0" Content="&lt;" Width="30" Height="26" Margin="0,0,6,0" Click="SourceBackButton_OnClick" ToolTip="Back" />
                        <Button x:Name="SourceForwardButton" Grid.Column="1" Content="&gt;" Width="30" Height="26" Margin="0,0,8,0" Click="SourceForwardButton_OnClick" ToolTip="Forward" />
                        <TextBlock x:Name="SourceCurrentPathTextBlock" Grid.Column="2" VerticalAlignment="Center" Foreground="#FFEAF3FF" TextTrimming="CharacterEllipsis" />
                    </Grid>
                    <ListView x:Name="SourceItemListView" Grid.Row="5" FontSize="14" SelectionMode="Extended" SelectionChanged="SourceItemListView_OnSelectionChanged" MouseDoubleClick="SourceItemListView_OnMouseDoubleClick" PreviewKeyDown="SourceItemListView_OnPreviewKeyDown" PreviewMouseMove="SourceItemListView_OnPreviewMouseMove" PreviewMouseRightButtonUp="SourceItemListView_OnPreviewMouseRightButtonUp" GridViewColumnHeader.Click="SourceItemColumnHeader_OnClick" AutomationProperties.Name="Source items list" KeyboardNavigation.TabNavigation="Continue" ItemContainerStyle="{StaticResource FileListItemStyle}">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="T" Width="34">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <Image Source="{Binding TypeIcon}" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn x:Name="SourceNameColumn" Header="Name" Width="260" DisplayMemberBinding="{Binding Name}" />
                                <GridViewColumn x:Name="SourceModifiedColumn" Header="Modified" Width="170" DisplayMemberBinding="{Binding ModifiedDisplay}" />
                            </GridView>
                        </ListView.View>
                        <ListView.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Open" Click="SourceContextOpen_OnClick" />
                                <MenuItem Header="Preview" Click="SourceContextPreview_OnClick" />
                                <Separator />
                                <MenuItem Header="Properties" Click="SourceContextProperties_OnClick" />
                            </ContextMenu>
                        </ListView.ContextMenu>
                    </ListView>
                </Grid>
            </GroupBox>

            <GridSplitter Grid.Column="3" Width="5" HorizontalAlignment="Stretch" Background="#FF5A6F90" />

            <GroupBox Header="Destination Items" Padding="8" Grid.Column="4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="TransferDestinationTextBlock"
                               Text="Going To: No destination selected"
                               Margin="2,0,2,8"
                               FontSize="12"
                               Foreground="#FFF1F7FF"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Row="1" Text="Search destination files and folders" FontSize="12" Foreground="#FFE9F2FF" Margin="2,0,0,4" />
                    <TextBox x:Name="DestinationSearchTextBox" Grid.Row="2" Height="36" FontSize="16" Padding="8,4,8,4" VerticalContentAlignment="Center" Margin="0,0,0,8" ToolTip="Search destination folder" TextChanged="DestinationSearchTextBox_OnTextChanged" AutomationProperties.Name="Search destination files and folders" />
                    <ComboBox x:Name="DestinationDateFilterComboBox" Grid.Row="3" Height="30" FontSize="14" Margin="0,0,0,8" SelectionChanged="DestinationDateFilterComboBox_OnSelectionChanged" AutomationProperties.Name="Destination date filter" Style="{StaticResource DateFilterComboBoxStyle}">
                        <ComboBoxItem Content="All Dates" IsSelected="True" Style="{StaticResource DateFilterComboBoxItemStyle}" />
                        <ComboBoxItem Content="Today" Style="{StaticResource DateFilterComboBoxItemStyle}" />
                        <ComboBoxItem Content="Last 7 Days" Style="{StaticResource DateFilterComboBoxItemStyle}" />
                        <ComboBoxItem Content="Last 30 Days" Style="{StaticResource DateFilterComboBoxItemStyle}" />
                        <ComboBoxItem Content="This Year" Style="{StaticResource DateFilterComboBoxItemStyle}" />
                    </ComboBox>
                    <Grid Grid.Row="4" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="DestinationBackButton" Grid.Column="0" Content="&lt;" Width="30" Height="26" Margin="0,0,6,0" Click="DestinationBackButton_OnClick" ToolTip="Back" />
                        <Button x:Name="DestinationForwardButton" Grid.Column="1" Content="&gt;" Width="30" Height="26" Margin="0,0,8,0" Click="DestinationForwardButton_OnClick" ToolTip="Forward" />
                        <TextBlock x:Name="DestinationCurrentPathTextBlock" Grid.Column="2" VerticalAlignment="Center" Foreground="#FFEAF3FF" TextTrimming="CharacterEllipsis" />
                    </Grid>
                    <ListView x:Name="DestinationItemListView" Grid.Row="5" FontSize="14" SelectionMode="Extended" SelectionChanged="DestinationItemListView_OnSelectionChanged" MouseDoubleClick="DestinationItemListView_OnMouseDoubleClick" PreviewKeyDown="DestinationItemListView_OnPreviewKeyDown" AllowDrop="True" Drop="DestinationItemListView_OnDrop" DragOver="DestinationItemListView_OnDragOver" PreviewMouseRightButtonUp="DestinationItemListView_OnPreviewMouseRightButtonUp" GridViewColumnHeader.Click="DestinationItemColumnHeader_OnClick" AutomationProperties.Name="Destination items list" KeyboardNavigation.TabNavigation="Continue" ItemContainerStyle="{StaticResource FileListItemStyle}">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="T" Width="34">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <Image Source="{Binding TypeIcon}" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn x:Name="DestinationNameColumn" Header="Name" Width="260" DisplayMemberBinding="{Binding Name}" />
                                <GridViewColumn x:Name="DestinationModifiedColumn" Header="Modified" Width="170" DisplayMemberBinding="{Binding ModifiedDisplay}" />
                            </GridView>
                        </ListView.View>
                        <ListView.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Open" Click="DestinationContextOpen_OnClick" />
                                <MenuItem Header="Preview" Click="DestinationContextPreview_OnClick" />
                                <Separator />
                                <MenuItem Header="Properties" Click="DestinationContextProperties_OnClick" />
                            </ContextMenu>
                        </ListView.ContextMenu>
                    </ListView>
                </Grid>
            </GroupBox>

            <Grid Grid.Column="5" Margin="0">
                <GridSplitter x:Name="DestinationLocationsGridSplitter" Width="5" HorizontalAlignment="Stretch" Background="#FF5A6F90" />
                <Button x:Name="DestinationLocationsCollapseButton"
                        Width="16"
                        Height="24"
                        Padding="0"
                        FontSize="11"
                    FontWeight="Bold"
                    Foreground="#FFFFFFFF"
                    Background="#FF30445E"
                    BorderBrush="#FF496386"
                    BorderThickness="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        Margin="0,12,0,0"
                        Click="ToggleDestinationLocationsColumnButton_OnClick"
                        ToolTip="Collapse destination locations" />
            </Grid>

            <GroupBox x:Name="DestinationLocationsGroupBox" Header="Destination Locations" Padding="8" Grid.Column="6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Configured destination roots" FontSize="13" Foreground="#FFC6D3E8" Margin="2,0,0,0" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="+" MinWidth="34" Height="28" Margin="0,0,6,0" FontSize="16" Click="DestinationAddLocationButton_OnClick" ToolTip="Add destination location" />
                            <Button Content="-" MinWidth="34" Height="28" FontSize="16" Click="DestinationRemoveLocationButton_OnClick" ToolTip="Remove selected destination location" />
                        </StackPanel>
                    </Grid>
                    <ListView x:Name="DestinationLocationListView" Grid.Row="1" FontSize="15" SelectionChanged="DestinationLocationListView_OnSelectionChanged" AutomationProperties.Name="Destination locations list" KeyboardNavigation.TabNavigation="Continue" ItemContainerStyle="{StaticResource LocationListItemStyle}">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DisplayName}" ToolTip="{Binding FullPath}" TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock x:Name="SelectedDestinationRootTextBlock" Grid.Row="2" Margin="2,8,2,0" FontSize="12" Foreground="#FFAEC4E6" Text="Destination root: none" TextTrimming="CharacterEllipsis" />
                </Grid>
            </GroupBox>
        </Grid>
    </DockPanel>
</Window>
