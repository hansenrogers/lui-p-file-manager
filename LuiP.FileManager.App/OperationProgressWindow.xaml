<Window x:Class="LuiP.FileManager.App.OperationProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Operation Progress"
        Width="680"
        Height="360"
        MinWidth="620"
        MinHeight="320"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="TitleTextBlock" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,12" Text="Operation in progress" />
        <TextBlock Grid.Row="1" x:Name="CurrentItemTextBlock" FontSize="14" Margin="0,0,0,8" TextWrapping="Wrap" />
        <TextBlock Grid.Row="2" x:Name="CountTextBlock" FontSize="14" Margin="0,0,0,8" />
        <ProgressBar Grid.Row="3" x:Name="ItemsProgressBar" Height="20" Minimum="0" Maximum="100" Margin="0,0,0,12" />
        <TextBlock Grid.Row="4" x:Name="SpeedEtaTextBlock" FontSize="13" Margin="0,0,0,8" />
        <TextBlock Grid.Row="5" x:Name="SummaryTextBlock" FontSize="13" TextWrapping="Wrap" />

        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="CancelButton" Content="Cancel" MinWidth="140" Height="44" Click="CancelButton_OnClick" />
        </StackPanel>
    </Grid>
</Window>
