<Window x:Class="LuiP.FileManager.App.IndexStatusWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Index Status - Lui-P File Manager"
        Width="900"
        Height="560"
        MinWidth="760"
        MinHeight="460"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="12">
        <Border DockPanel.Dock="Top" BorderBrush="#FFD8D8D8" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,10" Background="#FFF7F7F7">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Index Status" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Refresh" MinWidth="100" Padding="12,8" Margin="0,0,8,0" Click="RefreshButton_OnClick" />
                    <Button Content="Rebuild All" MinWidth="130" Padding="12,8" Click="RebuildButton_OnClick" />
                </StackPanel>
            </Grid>
        </Border>

        <DataGrid x:Name="StatusesDataGrid"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  FontSize="14"
                  RowHeaderWidth="0"
                  GridLinesVisibility="Horizontal">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Kind" Binding="{Binding Kind}" Width="90" />
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="150" />
                <DataGridTextColumn Header="Path" Binding="{Binding Path}" Width="*" />
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="120" />
                <DataGridTextColumn Header="Items" Binding="{Binding ItemCount}" Width="90" />
                <DataGridTextColumn Header="Last Updated (UTC)" Binding="{Binding LastIndexedUtc}" Width="170" />
                <DataGridTextColumn Header="Error" Binding="{Binding LastError}" Width="220" />
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock DockPanel.Dock="Bottom" x:Name="StatusTextBlock" Margin="0,10,0,0" FontSize="13" Text="Ready." />
    </DockPanel>
</Window>
