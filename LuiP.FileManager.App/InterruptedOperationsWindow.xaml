<Window x:Class="LuiP.FileManager.App.InterruptedOperationsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Interrupted Operations Recovery"
        Width="1000"
        Height="620"
        MinWidth="860"
        MinHeight="500"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="12">
        <Border DockPanel.Dock="Top" BorderBrush="#FFD8D8D8" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,10" Background="#FFF7F7F7">
            <TextBlock FontSize="16" TextWrapping="Wrap"
                       Text="The application found unfinished operations from a previous session. Review these entries before continuing." />
        </Border>

        <DataGrid x:Name="InterruptedDataGrid" AutoGenerateColumns="False" IsReadOnly="True" RowHeaderWidth="0" FontSize="14">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Started (UTC)" Binding="{Binding StartedUtc}" Width="170" />
                <DataGridTextColumn Header="Operation ID" Binding="{Binding OperationId}" Width="250" />
                <DataGridTextColumn Header="Type" Binding="{Binding OperationType}" Width="90" />
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100" />
                <DataGridTextColumn Header="Source" Binding="{Binding SourcePath}" Width="*" />
                <DataGridTextColumn Header="Destination" Binding="{Binding DestinationPath}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Retry (next phase)" MinWidth="160" Height="42" Margin="0,0,8,0" IsEnabled="False" />
            <Button Content="Close" MinWidth="120" Height="42" Click="CloseButton_OnClick" />
        </StackPanel>
    </DockPanel>
</Window>
