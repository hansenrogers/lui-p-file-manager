<Window x:Class="LuiP.FileManager.App.DeleteConfirmationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Confirm Delete"
        Width="700"
        Height="430"
        MinWidth="620"
        MinHeight="380"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="Delete Confirmation" FontSize="26" FontWeight="SemiBold" Margin="0,0,0,10" />

        <TextBlock Grid.Row="1" TextWrapping="Wrap" FontSize="16" Margin="0,0,0,8">
            <Run Text="You are about to delete selected items from:" />
            <LineBreak />
            <Run x:Name="LocationRun" FontWeight="SemiBold" />
        </TextBlock>

        <TextBlock Grid.Row="2" x:Name="CountTextBlock" FontSize="16" Margin="0,0,0,8" />
        <TextBlock Grid.Row="3" x:Name="SizeTextBlock" FontSize="16" Margin="0,0,0,8" />
        <TextBlock Grid.Row="4" x:Name="RecoveryTextBlock" FontSize="16" Margin="0,0,0,10" />

        <Border Grid.Row="5" BorderBrush="#FFD7D7D7" BorderThickness="1" CornerRadius="8" Padding="10" Background="#FFFCFCFC">
            <TextBlock TextWrapping="Wrap" FontSize="14">
                <Run Text="What will be deleted: the selected files and folders only." />
                <LineBreak />
                <Run Text="Current location: as shown above." />
                <LineBreak />
                <Run Text="Recovery: items are moved to the application's protected recovery area in this phase." />
            </TextBlock>
        </Border>

        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Cancel" IsDefault="True" MinWidth="160" Height="48" FontSize="16" Margin="0,0,10,0" Click="CancelButton_OnClick" />
            <Button Content="Delete" MinWidth="160" Height="48" FontSize="16" Click="DeleteButton_OnClick" />
        </StackPanel>
    </Grid>
</Window>
