<Window x:Class="LuiP.FileManager.App.DeleteConfirmationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Confirm Delete"
        Width="560"
        Height="280"
        MinWidth="520"
        MinHeight="250"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="Confirm Delete" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,10" />

        <TextBlock Grid.Row="1" TextWrapping="Wrap" FontSize="16" Margin="0,0,0,8">
            <Run Text="Are you sure you want to delete the selected item(s)?" />
        </TextBlock>

        <TextBlock Grid.Row="2" x:Name="CountTextBlock" FontSize="15" Margin="0,0,0,6" />
        <TextBlock Grid.Row="3" TextWrapping="Wrap" FontSize="14" Margin="0,0,0,10">
            <Run Text="Location: " />
            <LineBreak />
            <Run x:Name="LocationRun" FontWeight="SemiBold" />
        </TextBlock>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Cancel" IsDefault="True" MinWidth="160" Height="48" FontSize="16" Margin="0,0,10,0" Click="CancelButton_OnClick" />
            <Button Content="Delete" MinWidth="160" Height="48" FontSize="16" Click="DeleteButton_OnClick" />
        </StackPanel>
    </Grid>
</Window>
