<Window x:Class="LuiP.FileManager.App.SyncBoardSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sync Board Setup"
        Width="760"
        Height="250"
        MinWidth="700"
        MinHeight="230"
        Background="#FF161C26"
        Foreground="#FFDCE7F9"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="Choose source and Dropbox destination folders" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12" />

        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Source Root" VerticalAlignment="Center" />
            <TextBox x:Name="SourceRootTextBox" Grid.Column="1" Height="32" Margin="6,0,8,0" VerticalContentAlignment="Center" />
            <Button Grid.Column="2" Content="Browse..." MinWidth="95" Height="32" Click="BrowseSourceButton_OnClick" />
        </Grid>

        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Dropbox Root" VerticalAlignment="Center" />
            <TextBox x:Name="DestinationRootTextBox" Grid.Column="1" Height="32" Margin="6,0,8,0" VerticalContentAlignment="Center" />
            <Button Grid.Column="2" Content="Browse..." MinWidth="95" Height="32" Click="BrowseDestinationButton_OnClick" />
        </Grid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" MinWidth="110" Height="34" Margin="0,0,8,0" Click="CancelButton_OnClick" />
            <Button Content="Save" MinWidth="110" Height="34" Click="SaveButton_OnClick" />
        </StackPanel>
    </Grid>
</Window>
