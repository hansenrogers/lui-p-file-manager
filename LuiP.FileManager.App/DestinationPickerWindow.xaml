<Window x:Class="LuiP.FileManager.App.DestinationPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Choose Destination"
        Width="680"
        Height="460"
        MinWidth="560"
        MinHeight="360"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="Choose where to copy the selected Explorer item(s)." FontSize="16" Margin="0,0,0,10" />

        <ListBox x:Name="DestinationsListBox" Grid.Row="1" FontSize="14" DisplayMemberPath="Name" />

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Cancel" MinWidth="120" Height="40" Margin="0,0,8,0" Click="CancelButton_OnClick" />
            <Button Content="Copy Here" MinWidth="120" Height="40" Click="CopyButton_OnClick" />
        </StackPanel>
    </Grid>
</Window>
