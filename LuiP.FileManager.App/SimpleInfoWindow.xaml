<Window x:Class="LuiP.FileManager.App.SimpleInfoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lui-P File Manager"
        Width="760"
        Height="460"
        MinWidth="600"
        MinHeight="380"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="HeaderTextBlock" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,10" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <TextBlock x:Name="BodyTextBlock" FontSize="15" TextWrapping="Wrap" />
        </ScrollViewer>

        <Button Grid.Row="2" Content="Close" Width="120" Height="42" HorizontalAlignment="Right" Margin="0,12,0,0" Click="CloseButton_OnClick" />
    </Grid>
</Window>
