<Window x:Class="LuiP.FileManager.App.RetryItemSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Select Items to Retry"
        Width="760"
        Height="520"
        MinWidth="680"
        MinHeight="420"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="12">
        <TextBlock DockPanel.Dock="Top" Text="Select source items to retry" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10" />

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
            <Button Content="Select All" Width="120" Height="34" Margin="0,0,8,0" Click="SelectAllButton_OnClick" />
            <Button Content="Clear" Width="120" Height="34" Click="ClearButton_OnClick" />
        </StackPanel>

        <ListBox x:Name="ItemsListBox" SelectionMode="Extended" FontSize="14" />

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Cancel" Width="120" Height="38" Margin="0,0,8,0" Click="CancelButton_OnClick" />
            <Button Content="Retry Selected" Width="140" Height="38" Click="RetrySelectedButton_OnClick" />
        </StackPanel>
    </DockPanel>
</Window>
